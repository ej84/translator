{
  "version": 2,
  "builds": [
    { "src": "api/translate.js", "use": "@vercel/node" },
    { "src": "api/tts.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/translate", "dest": "/api/translate.js" },
    { "src": "/api/tts", "dest": "/api/tts.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
